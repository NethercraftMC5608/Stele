# x86-64 only, appended after nk.config by ldk.py (and part of its config
# hash). aarch64 keeps nk.config's "CONFIG_PCI is not set": its devices are
# virtio-mmio, and PCI would route every device's DMA through lkl_dma_ops.

# LKL's PCI host (arch/lkl/drivers/pci.c, pci-msi.c) over nk's pci_ops
# (core/src/lkl_pci_x86.rs). lkl_dma_ops then serves every device; nk's
# map_page is the identity, which is what dma-direct would have done.
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# The first Linux PCI driver: NVMe, with GPT so a real disk's table reads.
CONFIG_BLK_DEV_NVME=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y

# The first network driver: Intel 82574 / e1000e (QEMU q35's default NIC), and
# AF_PACKET, which busybox udhcpc needs to send DHCP before it has an address.
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000E=y
CONFIG_PACKET=y

# USB: xHCI host controllers (QEMU qemu-xhci, every modern PC) and HID, so a
# USB keyboard and mouse reach /dev/input/event* through CONFIG_INPUT_EVDEV.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# HD Audio: the Intel HDA controller and the generic/Realtek codec drivers,
# which cover QEMU's intel-hda + hda-duplex and most PC onboard audio.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCI=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_PROC_FS=y

# The real-hardware NICs on the roadmap, built in for when nk runs on a PC:
# Intel I225/I226 (igc) and Realtek RTL8111/8168/8125 (r8169).
CONFIG_IGC=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y
